# Banco (Postgres via Supabase). O service role nunca vai para o navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram: o grupo que aprova. CHAT_ID é identificador, não segredo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Só no modo webhook: valor que o Telegram devolve em X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# Instagram (conta Business + app próprio na Meta — veja docs/meta-setup.md)
META_LONG_LIVED_TOKEN=
IG_USER_ID=

# Endereço público do seu site, usado nos links dos posts
SITE_URL=

# Host da API da Meta. Padrão: graph.instagram.com (Instagram Login).
# Use https://graph.facebook.com se o seu app usa Login do Facebook + Página.
META_GRAPH_HOST=
